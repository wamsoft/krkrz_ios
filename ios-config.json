{
  "bundleId": "jp.wamsoft.krkrz.sample",
  "displayName": "krkrz",
  "version": "1.0",
  "build": 1,
  "deploymentTarget": "16.0",
  "devices": ["iphone", "ipad"],
  "orientations": ["landscapeLeft", "landscapeRight"],
  "graphics": "gles",
  "repl": true,
  "icon": "icon/AppIcon-1024.png",
  "ipa": { "baseName": "krkrz-sample" },
  "cmake": {
    "pluginFolders": [
      "${BUILD_SYSTEM_DIR}/plugins",
      "${KRKRZ_BASE}/krkrz_dev/src/plugins"
    ],
    "plugins": ["json", "virtualpad"]
  },
  "assetPack": {
    "baseFolder": "${BUILD_SYSTEM_DIR}",
    "sources": [
      {
        "comment": "ゲームのデータ (data/startup.tjs から起動)。サンプルはエンジン同梱のデモ",
        "type": "mirror",
        "from": "${KRKRZ_BASE}/krkrz_dev/src/core/data",
        "include": ["**/*"],
        "exclude": ["**/*.bak", "**/*.psd"]
      }
    ]
  }
}
